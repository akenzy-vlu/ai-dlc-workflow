# Where the ai-dlc-core skill is installed. The controller scripts live in <path>/scripts/.
AIDLC_CORE_PATH=/Users/you/.claude/skills/ai-dlc-core
# The ai-dlc-verify skill, for G4 evidence. Leave unset to disable that surface.
# verify is project-scoped, so nothing installs it globally any more and the built-in
# default (core's sibling) finds nothing — point this at the checkout, which the console
# runs against whichever repo you are viewing.
AIDLC_VERIFY_PATH=/path/to/this/checkout/skills/ai-dlc-verify
# Python interpreter used to run the controller. Must be python3.
AIDLC_PYTHON=python3
# Where the console keeps its own state (the tracked-repository registry). Never plan data.
AIDLC_CONSOLE_HOME=~/.aidlc-console
# HTTP port
PORT=7777
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# Seconds a parsed plan stays cached before it is re-read from disk
PLAN_CACHE_TTL_SECONDS=30
# How many controller subprocesses may run at once
CONTROLLER_CONCURRENCY=4

# Header carrying the authenticated user, set by whatever sits in front of the console
# (oauth2-proxy, an OIDC ingress, Tailscale, Cloudflare Access). When set, it is the ONLY
# source of the name written into a repository's audit trail — the request body is ignored,
# and a missing header is refused rather than fallen back from. Leave unset for a
# single-person laptop install, where the name comes from the client and is not evidence.
# AIDLC_TRUSTED_USER_HEADER=x-forwarded-user
