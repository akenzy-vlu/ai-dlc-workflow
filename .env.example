# Copy to .env — docker compose reads it automatically.
#
#   cp .env.example .env
#
# This file configures the CONTAINERS. Running the console natively instead? That is
# apps/api/.env, which is a different file with different defaults.

# ---------------------------------------------------------------------------
# Required. The host directory holding the repositories the console should track.
#
# It is bind-mounted at the same absolute path inside the container, because the
# tracked-repository registry stores absolute host paths — that is what makes a repo
# added natively resolve identically in Docker. Pick the directory that CONTAINS your
# repos, not a repo itself.
#
# It must be an ancestor of EVERY repository you track, or the ones outside it read as
# missing even though the registry lists them. `Documents` here because tracked repos live
# under both Documents/work and Documents/personal — check with:
#   python3 -c "import json,os;print(os.path.commonpath([e['absolutePath'] for e in json.load(open(os.path.expanduser('~/.aidlc-console/repositories.json')))]))"
AIDLC_WORKSPACE=/Users/you/work

# ---------------------------------------------------------------------------
# Which web service `docker compose up` starts. `prod` = nginx + built SPA.
# Override per-command with `docker compose --profile dev up`.
COMPOSE_PROFILES=prod

# ---------------------------------------------------------------------------
# Ports on the host.
WEB_PORT=8080
API_PORT=7777
DEV_PORT=5173

# Host ports for the backing services, used by `pnpm dev:hybrid` (API on this machine,
# state in the containers). Deliberately not 5432/6379/9000: those collide with whatever
# other project already has a Postgres or Redis running.
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
MINIO_HOST_PORT=59000

# ---------------------------------------------------------------------------
# Console-local state: repository registry, agents.json, evidence CAS.
# Defaults to ./.docker/console-home (gitignored). Point it at ~/.aidlc-console to
# share state with a native install.
# AIDLC_CONSOLE_HOME_HOST=/Users/you/.aidlc-console

# ---------------------------------------------------------------------------
# Which directories the Add-repository folder picker may browse. Compose sets this to
# AIDLC_WORKSPACE, which is both the useful root and the honest bound — it is exactly the
# part of the host the container can see. Natively it defaults to your home directory.
# AIDLC_BROWSE_ROOTS=/Users/you/work

# ---------------------------------------------------------------------------
# Which interface the published ports bind to. Loopback by default, because NOTHING in
# this stack authenticates: the API browses the filesystem, runs the controller as a
# subprocess, and can launch agent CLIs. Set this to 0.0.0.0 only behind an
# authenticating proxy, and set AIDLC_TRUSTED_USER_HEADER when you do.
BIND_ADDR=127.0.0.1

# ---------------------------------------------------------------------------
# Your agent CLI definitions, mounted read-only so the container lists the same agents a
# native run does. The CLIs themselves are NOT in the image — launching runs natively.
# AIDLC_AGENTS_FILE=/Users/you/.aidlc-console/agents.json

# ---------------------------------------------------------------------------
# Backing services. These defaults are fine while everything is on loopback. Change them
# before BIND_ADDR is anything else — they are published in this file and in git.
# The API talks to these over the compose network, so nothing here is published except
# the MinIO web console.
POSTGRES_USER=aidlc
POSTGRES_PASSWORD=aidlc
POSTGRES_DB=aidlc

MINIO_ROOT_USER=aidlc
MINIO_ROOT_PASSWORD=aidlc-secret
MINIO_BUCKET=aidlc-evidence
MINIO_CONSOLE_PORT=9001

# ---------------------------------------------------------------------------
# Where the Skills page syncs a `global`-scoped skill to. Point it at your real
# ~/.claude/skills so the container and a native install agree on what is installed;
# the default keeps writes inside the repo, where they affect nothing.
# AIDLC_GLOBAL_SKILLS_HOME_HOST=/Users/you/.claude/skills

# ---------------------------------------------------------------------------
# Who the controller writes as. On Linux set these to `id -u` / `id -g`, or aidlc.py
# leaves root-owned state files in your repositories. Harmless on macOS.
# AIDLC_UID=1000
# AIDLC_GID=1000

# ---------------------------------------------------------------------------
PLAN_CACHE_TTL_SECONDS=30
CONTROLLER_CONCURRENCY=4
