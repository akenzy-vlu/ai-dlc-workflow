# macOS
.DS_Store

# Python — the skills under skills/ are stdlib-only and have no build step
__pycache__/
*.py[cod]

# Playwright lives in a venv or site-packages, never in the repo
.venv/
venv/

# Node — the console under apps/
node_modules/
dist/
*.tsbuildinfo
*.log

# Local secrets and machine-specific config (apps/api/.env is per-machine)
.env
.env.local

# Per-machine allowlist for the ai-dlc plugin's hooks. The hooks fall back to their built-in
# defaults when it is absent, so this never has to be committed to be correct.
.claude/aidlc-hooks.json

# Editors
.vscode/
.idea/
*.swp

# Docker compose local state (console home bind mount)
.docker/
